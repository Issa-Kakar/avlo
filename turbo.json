{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // workers/sync/wrangler.jsonc: the compat-date source of truth for every test worker
  // (@avlo/test-support/aux-build reads it; all seven wrangler files bump in lockstep).
  "globalDependencies": ["tsconfig.base.json", "workers/sync/wrangler.jsonc"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    // Cached. Cross-package test inputs are covered by the dependency graph:
    // `dependsOn ^typecheck` folds every workspace dependency's file hash (incl.
    // @avlo/test-support and, transitively, shared/worker-shared/db) into this task's
    // hash. The two suites that esbuild ANOTHER worker's src as an aux worker declare
    // that extra edge explicitly below via $TURBO_ROOT$ inputs.
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "@avlo/sync#test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/workers/auth/src/**"],
      "outputs": []
    },
    "@avlo/users#test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "$TURBO_ROOT$/workers/sync/src/**", "$TURBO_ROOT$/workers/sync/drizzle/**"],
      "outputs": []
    },
    // ── @avlo/py-build: the python-toolchain pipeline (root `pnpm py:board`).
    // Gitignored build state (dist/raw, dist/groups, .cache) is hashed via
    // explicit `inputs` globs — verified on turbo 2.10: explicit globs DO hash
    // untracked files. The fork build IS a graph task (py:fork — BuildKit with a
    // machine-global layer cache, so a miss on unchanged pins is seconds of
    // export); the recipes lane (dist/groups/**) stays a manual command until
    // its replatform phase and enters as declared inputs. `.br` siblings are
    // deliberately NEVER inputs (compress outputs would self-invalidate
    // consumers).
    "@avlo/py-build#py:linkrsp": {
      "inputs": ["src/avlo_py_build/**", "config/dso-groups/groups.json", "dist/groups/*.so"],
      "outputs": [".cache/link-sos/**"]
    },
    // docker/fork.Dockerfile via `avlo-build fork`: every pin is a build-arg from
    // build.config.json, link.rsp is the closed-world closure baked into the link.
    "@avlo/py-build#py:fork": {
      "dependsOn": ["py:linkrsp"],
      "inputs": [
        "docker/**",
        "patches/pyodide/**",
        "patches/cpython/**",
        "patches/emsdk/**",
        "scripts/node/dump-builtins.mjs",
        "src/avlo_py_build/fork.py",
        "src/avlo_py_build/config.py",
        "build.config.json",
        ".cache/link-sos/link.rsp"
      ],
      "outputs": ["dist/raw/**", "!dist/raw/*.br"]
    },
    "@avlo/py-build#py:wheels": {
      "inputs": ["src/avlo_py_build/**", "build.config.json"],
      "outputs": [".cache/wheels/**", ".cache/pyodide-lock.json"]
    },
    "@avlo/py-build#py:stdlib": {
      "dependsOn": ["py:fork"],
      "inputs": ["src/avlo_py_build/**", "build.config.json", "config/stdlib-prune.txt", "overlay/**", "dist/raw/python_stdlib.zip"],
      "outputs": ["dist/stage/python_stdlib.zip", "dist/stage/stdlib-modules.json"]
    },
    // dependsOn py:stdlib: prebake-fontcache boots the STAGED stdlib zip.
    "@avlo/py-build#py:bundles": {
      "dependsOn": ["py:wheels", "py:stdlib", "py:fork"],
      "inputs": [
        "src/avlo_py_build/**",
        "scripts/node/**",
        "build.config.json",
        "config/pkg-prune/**",
        "config/dso-groups/groups.json",
        "patches/wheels/**",
        "dist/groups/*.so",
        ".cache/pyodide-lock.json",
        "dist/raw/pyodide.mjs",
        "dist/raw/pyodide.asm.mjs",
        "dist/raw/pyodide.asm.wasm"
      ],
      "outputs": ["dist/stage/bundles/**"]
    },
    "@avlo/py-build#py:trace-check": {
      "inputs": ["src/avlo_py_build/**", ".cache/trace/**", "config/stdlib-prune.txt", "config/pkg-prune/**"],
      "outputs": []
    },
    // census --check + verify-groups + verify-pytree (one board step).
    "@avlo/py-build#py:census": {
      "dependsOn": ["py:bundles", "py:wheels", "py:fork"],
      "inputs": [
        "src/avlo_py_build/**",
        "build.config.json",
        "config/dso-groups/**",
        "config/pkg-equality-allow.txt",
        "dist/raw/pyodide.asm.wasm",
        "dist/groups/**"
      ],
      "outputs": [".cache/dso-report.json"]
    },
    "@avlo/py-build#py:compress": {
      "dependsOn": ["py:stdlib", "py:bundles", "py:fork"],
      "inputs": [
        "src/avlo_py_build/**",
        "build.config.json",
        "dist/raw/pyodide.mjs",
        "dist/raw/pyodide.asm.mjs",
        "dist/raw/pyodide.asm.wasm"
      ],
      "outputs": ["dist/raw/*.br", "dist/stage/*.br", "dist/stage/bundles/*.br"]
    },
    "@avlo/py-build#py:budgets": {
      "dependsOn": ["py:compress"],
      "inputs": [
        "src/avlo_py_build/**",
        "build.config.json",
        "dist/raw/pyodide.mjs",
        "dist/raw/pyodide.asm.mjs",
        "dist/raw/pyodide.asm.wasm"
      ],
      "outputs": []
    },
    // Cross-package writes (web/public/py-dev, web/src gen files, py-loader
    // lock) — turbo outputs are package-relative, so stage stays UNCACHED
    // (seconds of copy + codegen); correctness rides dependsOn.
    "@avlo/py-build#py:stage": {
      "cache": false,
      "dependsOn": ["py:stdlib", "py:bundles", "py:fork"]
    },
    "@avlo/py-build#py:stage-check": {
      "cache": false,
      "dependsOn": ["py:stage"]
    },
    "@avlo/py-build#py:seed": {
      "cache": false,
      "dependsOn": ["py:stage", "py:compress"]
    },
    "@avlo/py-build#py:repro": {
      "cache": false
    },
    // pytest: toolchain units + the pytest-pyodide corpus lane (tests/corpus
    // boots the fork glue over the staged stdlib + bundle tars — all
    // gitignored, hence the explicit input globs).
    "@avlo/py-build#test:py": {
      "dependsOn": ["py:stdlib", "py:bundles", "py:fork"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/uv.lock",
        "dist/raw/pyodide.mjs",
        "dist/raw/pyodide.asm.mjs",
        "dist/raw/pyodide.asm.wasm",
        "dist/stage/python_stdlib.zip",
        "dist/stage/bundles/*.tar"
      ],
      "outputs": []
    },
    // The web py-integration vitest project (tests/py-integration) — the
    // JS-contract gate: shipped web/src/core/py modules against the staged
    // serving tree (gitignored ⇒ explicit glob; ^typecheck folds py-loader).
    "@avlo/web#test:py": {
      "dependsOn": ["^typecheck", "@avlo/py-build#py:stage"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "public/py-dev/fork/**"],
      "outputs": []
    },
    // Runs sync/auth/users/images from SOURCE via their real wrangler.jsonc files.
    "@avlo/integration#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/workers/sync/src/**",
        "$TURBO_ROOT$/workers/sync/drizzle/**",
        "$TURBO_ROOT$/workers/auth/src/**",
        "$TURBO_ROOT$/workers/users/src/**",
        "$TURBO_ROOT$/workers/users/drizzle/**",
        "$TURBO_ROOT$/workers/images/src/**",
        "$TURBO_ROOT$/workers/auth/wrangler.jsonc",
        "$TURBO_ROOT$/workers/users/wrangler.jsonc",
        "$TURBO_ROOT$/workers/images/wrangler.jsonc"
      ],
      "outputs": []
    }
  }
}
