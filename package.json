{
  "name": "avlo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,workers \"pnpm dev:web\" \"pnpm dev:workers\"",
    "dev:web": "pnpm --filter @avlo/web dev",
    "dev:workers": "node scripts/dev-miniflare.mjs",
    "dev:p": "PORT_OFFSET=10 VITE_PORT=5180 pnpm dev",
    "build": "turbo run build",
    "preview": "turbo run build && pnpm --filter @avlo/web preview",
    "typecheck": "turbo run typecheck",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "deploy:main": "pnpm --filter @avlo/main deploy",
    "deploy:sync": "pnpm --filter @avlo/sync deploy",
    "deploy:images": "pnpm --filter @avlo/images deploy",
    "deploy:unfurl": "pnpm --filter @avlo/unfurl deploy",
    "deploy:auth": "pnpm --filter @avlo/auth deploy",
    "deploy:users": "pnpm --filter @avlo/users deploy",
    "deploy": "pnpm deploy:main && pnpm deploy:sync && pnpm deploy:images && pnpm deploy:unfurl && pnpm deploy:auth && pnpm deploy:users",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^24.13.2",
    "@typescript/native-preview": "beta",
    "concurrently": "^10.0.3",
    "esbuild": "0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "miniflare": "4.20260515.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "wrangler": "~4.92.0"
  }
}
