{
  "name": "avlo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,workers \"pnpm dev:web\" \"pnpm dev:workers\"",
    "dev:web": "pnpm --filter @avlo/web dev",
    "dev:workers": "node scripts/dev-miniflare.mjs",
    "dev:p": "PORT_OFFSET=10 VITE_PORT=5180 pnpm dev",
    "build": "turbo run build",
    "preview": "pnpm --filter @avlo/web build:preview && concurrently -k -n web,workers \"pnpm --filter @avlo/web preview\" \"pnpm dev:workers\"",
    "preview:p": "PORT_OFFSET=10 VITE_PORT=5180 pnpm preview",
    "typecheck": "turbo run typecheck",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "verify:snap": "node scripts/verify/snap.mjs",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:py": "uv run --directory packages/py-build pytest",
    "deploy:main": "pnpm --filter @avlo/main deploy",
    "deploy:sync": "pnpm --filter @avlo/sync deploy",
    "deploy:images": "pnpm --filter @avlo/images deploy",
    "deploy:unfurl": "pnpm --filter @avlo/unfurl deploy",
    "deploy:auth": "pnpm --filter @avlo/auth deploy",
    "deploy:users": "pnpm --filter @avlo/users deploy",
    "deploy:py": "pnpm --filter @avlo/py deploy",
    "deploy": "pnpm deploy:main && pnpm deploy:sync && pnpm deploy:images && pnpm deploy:unfurl && pnpm deploy:auth && pnpm deploy:users && pnpm deploy:py",
    "py:seed": "pnpm --filter @avlo/py-build seed",
    "py:board": "pnpm --filter @avlo/py-build board",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@typescript/native-preview": "beta",
    "concurrently": "^10.0.3",
    "esbuild": "0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "miniflare": "4.20260630.0",
    "playwright": "^1.61.1",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "~4.106.0"
  }
}
