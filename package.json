{
  "name": "avlo",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n vite,main,images,unfurl \"npm:dev:client\" \"npm:dev:main\" \"npm:dev:images\" \"npm:dev:unfurl\"",
    "dev:client": "npm run dev -w client",
    "dev:main": "node scripts/dev-worker.mjs main",
    "dev:images": "node scripts/dev-worker.mjs images",
    "dev:unfurl": "node scripts/dev-worker.mjs unfurl",
    "dev:p": "PORT_OFFSET=4 VITE_PORT=3001 npm run dev",
    "build": "npm run build -w client",
    "preview": "concurrently -k -n vite,main,images,unfurl \"npm run preview -w client\" \"npm:dev:main\" \"npm:dev:images\" \"npm:dev:unfurl\"",
    "deploy:main": "wrangler deploy -c workers/main/wrangler.jsonc",
    "deploy:images": "wrangler deploy -c workers/images/wrangler.jsonc",
    "deploy:unfurl": "wrangler deploy -c workers/unfurl/wrangler.jsonc",
    "deploy": "npm run deploy:main && npm run deploy:images && npm run deploy:unfurl",
    "typecheck": "npm run -w client typecheck && npm run -w workers/main typecheck && npm run -w workers/images typecheck && npm run -w workers/unfurl typecheck",
    "typecheck:tsc": "npm run -w client typecheck:tsc && npm run -w workers/main typecheck:tsc && npm run -w workers/images typecheck:tsc && npm run -w workers/unfurl typecheck:tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@rollup/rollup-linux-x64-gnu": "^4.46.3",
    "@types/node": "^22.13.4",
    "@typescript/native-preview": "beta",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.85.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
