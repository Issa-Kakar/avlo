{
  "name": "avlo",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n vite,workers \"npm:dev:client\" \"npm:dev:workers\"",
    "dev:client": "npm run dev -w client",
    "dev:workers": "node scripts/dev-miniflare.mjs",
    "dev:sync": "node scripts/dev-worker.mjs sync",
    "dev:images": "node scripts/dev-worker.mjs images",
    "dev:unfurl": "node scripts/dev-worker.mjs unfurl",
    "dev:auth": "node scripts/dev-worker.mjs auth",
    "dev:users": "node scripts/dev-worker.mjs users",
    "dev:p": "PORT_OFFSET=10 VITE_PORT=5180 npm run dev",
    "dev:legacy": "concurrently -k -n vite,sync,images,unfurl,auth,users \"npm:dev:client\" \"npm:dev:sync\" \"npm:dev:images\" \"npm:dev:unfurl\" \"npm:dev:auth\" \"npm:dev:users\"",
    "build": "npm run build -w client",
    "preview": "concurrently -k -n vite,sync,images,unfurl,auth,users \"npm run preview -w client\" \"npm:dev:sync\" \"npm:dev:images\" \"npm:dev:unfurl\" \"npm:dev:auth\" \"npm:dev:users\"",
    "deploy:main": "wrangler deploy -c workers/main/wrangler.jsonc",
    "deploy:sync": "wrangler deploy -c workers/sync/wrangler.jsonc",
    "deploy:images": "wrangler deploy -c workers/images/wrangler.jsonc",
    "deploy:unfurl": "wrangler deploy -c workers/unfurl/wrangler.jsonc",
    "deploy:auth": "wrangler deploy -c workers/auth/wrangler.jsonc",
    "deploy:users": "wrangler deploy -c workers/users/wrangler.jsonc",
    "deploy": "npm run deploy:main && npm run deploy:sync && npm run deploy:images && npm run deploy:unfurl && npm run deploy:auth && npm run deploy:users",
    "typecheck": "npm run -w client typecheck && npm run -w workers/sync typecheck && npm run -w workers/images typecheck && npm run -w workers/unfurl typecheck && npm run -w workers/auth typecheck && npm run -w workers/users typecheck",
    "typecheck:tsc": "npm run -w client typecheck:tsc && npm run -w workers/sync typecheck:tsc && npm run -w workers/images typecheck:tsc && npm run -w workers/unfurl typecheck:tsc && npm run -w workers/auth typecheck:tsc && npm run -w workers/users typecheck:tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@rollup/rollup-linux-x64-gnu": "^4.46.3",
    "@types/node": "^22.13.4",
    "@typescript/native-preview": "beta",
    "concurrently": "^8.2.2",
    "esbuild": "0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "miniflare": "4.20260515.0",
    "typescript": "^6.0.3",
    "wrangler": "~4.92.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
