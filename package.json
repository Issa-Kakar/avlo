{
  "name": "avlo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "concurrently -k -n vite,workers \"pnpm dev:client\" \"pnpm dev:workers\"",
    "dev:client": "pnpm --filter @avlo/web dev",
    "dev:workers": "node scripts/dev-miniflare.mjs",
    "dev:sync": "node scripts/dev-worker.mjs sync",
    "dev:images": "node scripts/dev-worker.mjs images",
    "dev:unfurl": "node scripts/dev-worker.mjs unfurl",
    "dev:auth": "node scripts/dev-worker.mjs auth",
    "dev:users": "node scripts/dev-worker.mjs users",
    "dev:p": "PORT_OFFSET=10 VITE_PORT=5180 pnpm dev",
    "dev:legacy": "concurrently -k -n vite,sync,images,unfurl,auth,users \"pnpm dev:client\" \"pnpm dev:sync\" \"pnpm dev:images\" \"pnpm dev:unfurl\" \"pnpm dev:auth\" \"pnpm dev:users\"",
    "build": "turbo run build",
    "preview": "concurrently -k -n vite,sync,images,unfurl,auth,users \"pnpm --filter @avlo/web preview\" \"pnpm dev:sync\" \"pnpm dev:images\" \"pnpm dev:unfurl\" \"pnpm dev:auth\" \"pnpm dev:users\"",
    "deploy:main": "wrangler deploy -c workers/main/wrangler.jsonc",
    "deploy:sync": "wrangler deploy -c workers/sync/wrangler.jsonc",
    "deploy:images": "wrangler deploy -c workers/images/wrangler.jsonc",
    "deploy:unfurl": "wrangler deploy -c workers/unfurl/wrangler.jsonc",
    "deploy:auth": "wrangler deploy -c workers/auth/wrangler.jsonc",
    "deploy:users": "wrangler deploy -c workers/users/wrangler.jsonc",
    "deploy": "pnpm deploy:main && pnpm deploy:sync && pnpm deploy:images && pnpm deploy:unfurl && pnpm deploy:auth && pnpm deploy:users",
    "typecheck": "turbo run typecheck",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^22.13.4",
    "@typescript/native-preview": "beta",
    "concurrently": "^8.2.2",
    "esbuild": "0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "miniflare": "4.20260515.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "wrangler": "~4.92.0"
  }
}
