# Deploy target → *.avlo.io origins (packages/api-client/src/origins.ts).
# Committed, NON-SECRET: VITE_* values are baked into the client bundle regardless.
# Auto-loaded by the DEFAULT `vite build` (mode=production) — the deploy artifact.
# Un-ignored in the root .gitignore (which otherwise ignores .env.*).
VITE_TARGET=production
