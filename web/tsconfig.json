{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@avlo/shared": ["../packages/shared/src/index.ts"],
      "@avlo/shared/*": ["../packages/shared/src/*"],
      "@avlo/api-client": ["../packages/api-client/src/index.ts"],
      "@avlo/api-client/*": ["../packages/api-client/src/*"],
      "@avlo/py-loader": ["../packages/py-loader/src/index.ts"]
    },
    "types": ["vite/client", "node", "react", "react-dom", "@webgpu/types"]
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "src/sw.ts"]
}
