{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2024.SharedMemory"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@avlo/shared": ["../packages/shared/src/index.ts"],
      "@avlo/shared/*": ["../packages/shared/src/*"],
      "@avlo/api-client": ["../packages/api-client/src/index.ts"],
      "@avlo/api-client/*": ["../packages/api-client/src/*"]
    },
    "types": ["vite/client", "node", "react", "react-dom"],
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/sw.ts"]
}
