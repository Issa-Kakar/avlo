# Deploy target → *.staging.avlo.io origins. Loaded by `vite build --mode staging`
# (pnpm --filter @avlo/web build:staging). Non-secret; committed.
# NOTE: a staging DEPLOY also needs a staging CSP + wrangler [env.staging] + DNS/buckets —
# see the STAGING CHECKLIST in packages/api-client/src/origins.ts.
VITE_TARGET=staging
