{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/.wrangler",
      "!**/.tanstack",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.cache",
      "!**/.turbo",
      "!web/src/routeTree.gen.ts",
      "!web/src/core/py/pyodide-fork.gen.d.ts",
      "!packages/py-loader/build-lock.json",
      "!web/src/core/code/vendor/sql/sql.grammar.js",
      "!web/src/core/code/vendor/sql/sql.grammar.terms.js",
      "!workers/**/worker-configuration.d.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": {}
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } },
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error",
        "useExportType": "error",
        "useShorthandFunctionType": "error",
        "useFragmentSyntax": "error",
        "useConsistentBuiltinInstantiation": "error",
        "noUnusedTemplateLiteral": "error"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "a11y": {
        "preset": "none"
      },
      "complexity": {
        "useFlatMap": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefinedInitialization": "error",
        "useDateNow": "error"
      },
      "correctness": {
        "noConstantMathMinMaxClamp": "error",
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/**/*.{ts,tsx,js,jsx}"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "playwright.config.ts", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/verify/**", "web/scripts/**", "web/src/dev/**", "packages/py-build/scripts/**", "packages/py-build/bench/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["web/src/core/code/vendor/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noShadowRestrictedNames": "off"
          }
        }
      }
    }
  ]
}
