 .../SpatialIndexManager/ShapeSpatialIndex.ts  | 75 +++++++++++++++++--
 .../tldraw/src/test/spatialIndexPerf.test.ts  | 62 ++++++++++-----
 3 files changed, 147 insertions(+), 25 deletions(-)

