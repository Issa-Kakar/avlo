 				place()
 				editor.getCulledShapes()
 			}
-			let visible = 0
 			let sum = 0
-			const ns = time(() => {
-				for (let f = 0; f < FRAMES; f++) {
-					place()
-					sum += editor.getCulledShapes().size
-				}
-			})
-			visible = SHAPE_COUNT - Math.round(sum / FRAMES)
-			record(label, ns, FRAMES, `~${visible} shapes on screen`)
