# Dependencies
node_modules/

# Python virtualenvs (uv-managed — e.g. packages/py-build/.venv). Ad-hoc script
# runs (uv run scripts/subset-*.py) use uv's shared cache, not a checked-in venv.
.venv/

# Build output
dist/
*.tsbuildinfo

# Logs
*.log

# Environment variables & secrets
.env
.env.*
.dev.vars
**/.dev.vars
*.pem
# ...except the committed, non-secret deploy-target selectors (VITE_* is baked into the
# client bundle anyway; these pick prod/staging origins — see api-client/src/origins.ts).
!web/.env.production
!web/.env.staging

# Tooling caches (Wrangler/Miniflare, Turborepo, TanStack Router)
.wrangler/
*/.wrangler/
.turbo/
**/.turbo/
.tanstack/
*/.tanstack/

# Verification harness output + Playwright artifacts + Vitest coverage
.verify/
test-results/
playwright-report/
coverage/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Personal notes / local-only
docs(local)
completed_tasks/
.claude/
PROMPT.MD
prompt.md

# Python toolchain build workspace (packages/py-build) — clone + container caches
packages/py-build/.work/
# Downloaded recipe wheels (sha-pinned in build.config.json)
packages/py-build/.cache/
# py-build staging target (stage.mjs writes the fork artifacts here)
web/public/py-dev/

# Python bytecode (host pack scripts)
__pycache__/

# LLVM profiling artifacts dropped by instrumented tooling
*.profraw
