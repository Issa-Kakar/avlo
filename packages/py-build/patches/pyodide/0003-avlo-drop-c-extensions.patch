From: avlo-py-build <py-build@avlo.local>
Subject: [PATCH] AVLO: drop _ctypes, _bz2, CJK codecs, pyexpat, _lsprof

Canvas snippets need none of these; _ctypes additionally grows the wasm
table at runtime (callback trampolines), which would defeat the blit-reset
run-isolation guard. Rollback of any single drop is one Setup.local line.

--- a/cpython/Setup.local	2026-07-04 22:39:37.962585280 -0700
+++ b/cpython/Setup.local	2026-07-04 22:39:38.026585479 -0700
@@ -6,12 +6,10 @@
 
 *static*
 
-CTYPES_FLAGS=-DHAVE_FFI_PREP_CIF_VAR=1 -DHAVE_FFI_PREP_CLOSURE_LOC=1 -DHAVE_FFI_CLOSURE_ALLOC=1 -I ../libffi/include
-_ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/cfield.c _ctypes/stgdict.c $(CTYPES_FLAGS)
-
+# AVLO: _ctypes and _bz2 dropped (canvas snippets need neither; ctypes also
+# grows the wasm table at runtime, which would defeat blit-reset run isolation).
 _posixsubprocess _posixsubprocess.c
 
-_bz2 _bz2module.c -lbz2
 zlib zlibmodule.c
 
 
@@ -22,3 +20,15 @@
 _lzma
 _hashlib
 _uuid
+_ctypes
+_bz2
+_codecs_cn
+_codecs_hk
+_codecs_iso2022
+_codecs_jp
+_codecs_kr
+_codecs_tw
+_multibytecodec
+_lsprof
+pyexpat
+_elementtree
