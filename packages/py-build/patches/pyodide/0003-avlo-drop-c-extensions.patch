From: avlo-py-build <py-build@avlo.local>
Subject: [PATCH] AVLO: drop _ctypes, _bz2, _lzma, CJK codecs, pyexpat, _lsprof

Canvas snippets need none of these; _ctypes additionally grows the wasm
table at runtime (callback trampolines), which would defeat the blit-reset
run-isolation guard. Rebased to 314's Setup.local: upstream now disables
pwd/_ssl/_hashlib/_uuid itself and builds _hmac (HACL) + _sqlite3 static —
both KEPT (sqlite3-static kills the old set-riding sqlite3 bundle). _lzma
was disabled on the 0.29 fork too (never shipped). _zstd was dropped with
it P1..2026-08, now STATIC again (fast user-code compression + the future
direct-from-OPFS tar direction; libzstd.a was always built, only the
module was off — 0001 carries the matching -lzstd). Rollback of any
single drop is one Setup.local line.
diff --git a/cpython/Setup.local b/cpython/Setup.local
index 9ea6c46..ff39c56 100644
--- a/cpython/Setup.local
+++ b/cpython/Setup.local
@@ -6,21 +6,36 @@
 
 *static*
 
-CTYPES_FLAGS=-DHAVE_FFI_PREP_CIF_VAR=1 -DHAVE_FFI_PREP_CLOSURE_LOC=1 -DHAVE_FFI_CLOSURE_ALLOC=1 -I ../libffi/include
-_ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/cfield.c _ctypes/stgdict.c $(CTYPES_FLAGS)
-
+# AVLO: _ctypes, _bz2, _lzma dropped from the static set (canvas snippets
+# need none — the 0.29 fork shipped without lzma too; ctypes also
+# grows the wasm table at runtime, which would defeat blit-reset run
+# isolation). Their bare names ride *disabled* below alongside our codec/
+# profiling/xml drops. Rollback of any single drop is one line. _zstd is
+# STATIC (2026-08): fast user-code compression + the future direct-from-
+# OPFS tar direction; libzstd.a was always built, only the module was off.
 _posixsubprocess _posixsubprocess.c
 
-_bz2 _bz2module.c -lbz2
 zlib zlibmodule.c
+_zstd _zstd/_zstdmodule.c _zstd/compressor.c _zstd/decompressor.c _zstd/zstddict.c -I../zstd/dist/include -L../zstd/dist/lib -lzstd
 
 _hmac hmacmodule.c _hacl/Hacl_Hash_MD5.c _hacl/Hacl_Hash_SHA1.c _hacl/Hacl_Hash_SHA2.c _hacl/Hacl_Hash_SHA3.c _hacl/Hacl_Hash_Blake2b.c _hacl/Hacl_Hash_Blake2s.c _hacl/Hacl_HMAC.c _hacl/Hacl_Streaming_HMAC.c _hacl/Lib_Memzero0.c -I$(srcdir)/Modules/_hacl -I$(srcdir)/Modules/_hacl/include -I$(srcdir)/Modules/_hacl/internal
 _sqlite3 _sqlite/blob.c _sqlite/connection.c _sqlite/cursor.c _sqlite/microprotocols.c _sqlite/module.c _sqlite/prepare_protocol.c _sqlite/row.c _sqlite/statement.c _sqlite/util.c -lsqlite3
-_lzma _lzmamodule.c -I../lzma/dist/include -L../lzma/dist/lib -llzma
-_zstd _zstd/_zstdmodule.c _zstd/compressor.c _zstd/decompressor.c _zstd/zstddict.c -I../zstd/dist/include -L../zstd/dist/lib -lzstd
 
 *disabled*
 pwd
 _uuid
 _ssl
 _hashlib
+_ctypes
+_bz2
+_lzma
+_codecs_cn
+_codecs_hk
+_codecs_iso2022
+_codecs_jp
+_codecs_kr
+_codecs_tw
+_multibytecodec
+_lsprof
+pyexpat
+_elementtree
