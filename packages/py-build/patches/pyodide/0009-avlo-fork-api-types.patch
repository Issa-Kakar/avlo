+import type { PyodideModule } from "./types";
 import { RUNTIME_ENV } from "./environments";
 // @ts-ignore
 import LiteralMap from "./common/literal-map";
@@ -132,6 +134,18 @@ export class PyodideAPI_ {
   /** @hidden */
   static setStderr = setStderr;
 
+  /**
+   * AVLO (0009): the live Emscripten Module and the internal API object —
+   * the fork-private surfaces the app's boot/capture/restore path types
+   * against. Assigned (untyped, upstream) in makePublicAPI below; declared
+   * here so the emitted pyodide.d.ts carries them. `declare` = type-only,
+   * zero runtime emission.
+   * @hidden
+   */
+  declare static _module: PyodideModule;
+  /** @hidden AVLO (0009): see _module. */
+  declare static _api: PyodideModule["API"];
+
   /**
    *
    * An alias to the global Python namespace.
