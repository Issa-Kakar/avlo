From: avlo-py-build <py-build@avlo.local>
Subject: [PATCH] AVLO: snapshot meta v1 (DSO record + pre-restore hook)

SnapshotConfig gains an avlo block: DSO loadOrder/memory/table bases plus
live dlopen handles (workerd SnapshotMeta shape, Apache-2.0). restoreSnapshot
enforces the restore order inside the fork: parse -> pre-grow -> replay DSOs
via config._preRestoreHook -> heap overwrite.

--- a/src/js/snapshot.ts	2026-07-04 22:37:22.194608981 -0700
+++ b/src/js/snapshot.ts	2026-07-04 22:37:49.670599047 -0700
@@ -1,4 +1,18 @@
 import { scheduleCallback } from "./scheduler";
+import type { DsoLoadInfo } from "./dynload";
+
+/**
+ * AVLO snapshot meta v1 (adapted from Cloudflare workerd's SnapshotMeta,
+ * Apache-2.0). Records everything needed to re-instantiate dynamic libraries
+ * at the SAME memory/table bases before the heap overwrite on restore.
+ */
+export type AvloSnapshotMeta = {
+  version: 1;
+  snapshotType: "baseline" | "stacked";
+  dso: DsoLoadInfo;
+  dsoHandles: Record<string, { handles: number[] }>;
+  heapSize: number;
+};
 
 declare var Module: any;
 
@@ -80,6 +94,7 @@
 export type SnapshotConfig = {
   hiwireKeys: SerializedHiwireValue[];
   immortalKeys: string[];
+  avlo?: AvloSnapshotMeta;
 };
 
 const SNAPSHOT_MAGIC = 0x706e7300; // "\x00snp"
@@ -234,6 +249,16 @@
     );
   }
   const snapshotConfig = API.serializeHiwireState(serializer);
+  // AVLO: bake the DSO record + live dlopen handles into the meta so restore
+  // can replay identical bases (empty on a baseline snapshot — asserted by
+  // the baseline build step).
+  snapshotConfig.avlo = {
+    version: 1,
+    snapshotType: API.getDsoLoadInfo().loadOrder.length ? "stacked" : "baseline",
+    dso: API.getDsoLoadInfo(),
+    dsoHandles: API.recordDsoHandles(),
+    heapSize: Module.HEAP8.length,
+  };
   const snapshotConfigString = JSON.stringify(snapshotConfig);
   let snapshotOffset = HEADER_SIZE_IN_BYTES + 2 * snapshotConfigString.length;
   // align to 16 bytes
@@ -280,6 +305,21 @@
   snapshot = snapshot.subarray(snapshotOffset);
   const jsonStr = new TextDecoder().decode(jsonBuf);
   const snapshotConfig: SnapshotConfig = JSON.parse(jsonStr);
+  // AVLO (workerd restore order): pre-grow memory, re-instantiate recorded
+  // DSOs at their recorded bases, THEN overwrite the heap. Table entries and
+  // GOT wasm-globals live outside linear memory and survive the overwrite;
+  // anything the instantiation wrote INTO the heap is corrected by it.
+  if (snapshotConfig.avlo?.dso.loadOrder.length) {
+    if (!API.config._preRestoreHook) {
+      throw new Error(
+        "Snapshot contains dynamic libraries but no _preRestoreHook was provided",
+      );
+    }
+    if (snapshot.length > Module.HEAP8.length) {
+      Module.growMemory(snapshot.length);
+    }
+    API.config._preRestoreHook(snapshotConfig.avlo, Module);
+  }
   // @ts-ignore
   Module.HEAP8.set(snapshot);
   return snapshotConfig;
