From: avlo-py-build <py-build@avlo.local>
Subject: [PATCH] AVLO: js-bridge closure — no "js" module registration

Delete the one registration that makes the host realm importable from
Python: importhook.register_js_module("js", jsglobals) in
finalizeBootstrap's non-snapshot branch. JsFinder.find_spec resolves
top-level names ONLY from jsfinder.jsproxies, so without it `import js`
exhausts the full meta_path -> ModuleNotFoundError at finder level,
independent of the in-Python harness guard (which stays for pyodide_js/
pyodide/_pyodide coverage). register_js_finder() and the "pyodide_js"
registration stay: webloop does `from pyodide_js._api import
scheduleCallback` at import time and pyodide/__init__ runs
_initialize_event_loop() during boot — removing either breaks boot.
jsglobals itself stays referenced by the snapshot branch (restore
rebuilds jsproxies from the captured _state image; the baseline is
recaptured post-0008, restage => recapture).

Snapshot consequence: getExpectedKeys() hardcodes the first hiwire
regular-table entries in boot allocation order, and the "js"
registration was what interned jsglobals (slot 1) plus a trailing {}
(slot 6). Post-0008 the table is [null, public_api, API,
scheduleCallback, API] (verified empirically, stable across warmups+gc)
— without this update makeSnapshot's checkEntry dies stringifying
public_api (circular Module.FS root) against the stale jsglobals
expectation. Capture and restore share the list; BUILD_ID gating
rejects pre-0008 snapshots.

--- a/src/js/api.ts	2026-07-06 10:00:00.000000000 -0700
+++ b/src/js/api.ts	2026-07-06 10:00:00.000000000 -0700
@@ -731,7 +731,6 @@ API.finalizeBootstrap = function (
     syncUpSnapshotLoad2(jsglobals, snapshotConfig, snapshotDeserializer);
   } else {
     importhook.register_js_finder();
-    importhook.register_js_module("js", jsglobals);
     importhook.register_js_module("pyodide_js", pyodide);
     importhook.register_windows_finder();
   }
--- a/src/js/snapshot.ts	2026-07-06 10:00:00.000000000 -0700
+++ b/src/js/snapshot.ts	2026-07-06 10:00:00.000000000 -0700
@@ -18,15 +18,12 @@ declare var Module: any;

 /** @private */
 API.getExpectedKeys = function () {
-  return [
-    null,
-    API.config.jsglobals,
-    API.public_api,
-    API,
-    scheduleCallback,
-    API,
-    {},
-  ];
+  // AVLO (0008): with register_js_module("js", jsglobals) gone, jsglobals is
+  // never interned and the trailing {} entry that registration produced is
+  // gone too — the post-boot table is exactly these five entries. Restore
+  // (syncUpSnapshotLoad2) re-interns the same list, and BUILD_ID gating
+  // rejects any snapshot captured under the old layout.
+  return [null, API.public_api, API, scheduleCallback, API];
 };

 // Symbol used in our serializer to get the access list
