From: avlo-py-build <py-build@avlo.local>
Subject: [PATCH] AVLO: DSO base record/replay hook for linear-memory snapshots

Adds Module.dsoBaseHook to loadWebAssemblyModule so a host runtime can
record DSO memory/table base allocations (snapshot creation) and replay
them (snapshot restore). Adapted from Cloudflare workerd (Apache-2.0):
https://github.com/cloudflare/workerd/blob/main/src/pyodide/internal/snapshot.ts

--- a/src/lib/libdylink.js	2026-07-04 22:31:22.834695925 -0700
+++ b/src/lib/libdylink.js	2026-07-04 22:32:00.894674940 -0700
@@ -638,8 +638,28 @@
         // alignments are powers of 2
         var memAlign = Math.pow(2, metadata.memoryAlign);
         // prepare memory
-        var memoryBase = metadata.memorySize ? alignMemory(getMemory(metadata.memorySize + memAlign), memAlign) : 0; // TODO: add to cleanups
-        var tableBase = metadata.tableSize ? {{{ from64Expr('wasmTable.length') }}} : 0;
+        // AVLO snapshot support (adapted from Cloudflare workerd's Python
+        // runtime, Apache-2.0): Module.dsoBaseHook records fresh DSO base
+        // allocations, and replays recorded bases when restoring a
+        // linear-memory snapshot so function pointers baked into the restored
+        // heap stay valid. Replay skips getMemory() entirely — the restored
+        // heap's allocator state already owns the region. Table drift throws:
+        // crashing early beats a delayed segfault.
+        var dsoReplay = Module['dsoBaseHook'] && Module['dsoBaseHook'].replay(libName);
+        var memoryBase, tableBase;
+        if (dsoReplay) {
+          memoryBase = dsoReplay[0];
+          tableBase = dsoReplay[1];
+          if (metadata.tableSize && {{{ from64Expr('wasmTable.length') }}} != tableBase) {
+            throw new Error(`snapshot DSO table drift for ${libName}: expected table base ${tableBase}, got ${wasmTable.length}`);
+          }
+        } else {
+          memoryBase = metadata.memorySize ? alignMemory(getMemory(metadata.memorySize + memAlign), memAlign) : 0; // TODO: add to cleanups
+          tableBase = metadata.tableSize ? {{{ from64Expr('wasmTable.length') }}} : 0;
+          if (Module['dsoBaseHook']) {
+            Module['dsoBaseHook'].record(libName, memoryBase, tableBase);
+          }
+        }
         if (handle) {
           {{{ makeSetValue('handle', C_STRUCTS.dso.mem_allocated, '1', 'i8') }}};
           {{{ makeSetValue('handle', C_STRUCTS.dso.mem_addr, 'memoryBase', '*') }}};
