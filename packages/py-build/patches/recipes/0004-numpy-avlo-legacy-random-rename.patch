@@ -0,0 +1,105 @@
+AVLO py-build P1.5 (DSO grouping 67->4): rename mtrand's legacy random_*
+family so numpy's group link keeps RandomState's long-typed copies of
+src/distributions/distributions.c disjoint from libnpyrandom.a's
+int64-typed copies. Full rationale in the added header comment; the
+rename set is mechanically ALL 66 strong defs of the legacy-compiled TU
+(llvm-nm), re-proven disjoint by harvest-links.py's collision gate on
+every rebuild. Shipped artifacts stage the upstream wheels (this header
+never ships; rebuilt wheels are harvest/verify inputs only).
+
+diff --git a/numpy/_core/include/numpy/random/distributions.h b/numpy/_core/include/numpy/random/distributions.h
+--- a/numpy/_core/include/numpy/random/distributions.h
++++ b/numpy/_core/include/numpy/random/distributions.h
+@@ -28,6 +28,92 @@
+ #define RAND_INT_MAX INT64_MAX
+ #endif
+ 
++/*
++ * AVLO (py-build P1.5 DSO grouping): RandomState's extension (mtrand)
++ * compiles its own copy of distributions.c with long-typed RAND_INT_TYPE,
++ * while every other numpy.random extension links the int64-typed copies in
++ * libnpyrandom.a. Upstream the two copies live in separate shared objects
++ * and never meet. The avlo build links all numpy extensions into ONE
++ * grouped side module, where mtrand's immediate object definitions would
++ * shadow the lazy archive members for every caller (wasm-ld pulls archive
++ * members only for still-undefined symbols), cross-wiring int64 callers
++ * into the long-typed bodies -- a fatal wasm function-signature mismatch.
++ * Renaming the whole legacy family here (defs AND refs -- all three mtrand
++ * TUs include this header and only they define NP_RANDOM_LEGACY) keeps the
++ * two copies disjoint, reproducing upstream's per-DSO binding exactly.
++ * The rename set is ALL 66 strong defs of the legacy-compiled TU; the
++ * harvest collision gate (harvest-links.py) re-proves disjointness on
++ * every rebuild.
++ */
++#ifdef NP_RANDOM_LEGACY
++#define random_beta __avlo_legacy_random_beta
