AVLO: persist pandas's meson-python build tree (backend-flags build-dir=build,
numpy's existing idiom) so the P1.5 group-link harvest can collect the
recorded .o/.a link inputs after the build. Upstreamable one-liner.

diff --git a/packages/pandas/meta.yaml b/packages/pandas/meta.yaml
index e3ce142..869e49b 100644
--- a/packages/pandas/meta.yaml
+++ b/packages/pandas/meta.yaml
@@ -9,6 +9,8 @@ source:
   url: https://files.pythonhosted.org/packages/source/p/pandas/pandas-3.0.2.tar.gz
   sha256: f4753e73e34c8d83221ba58f232433fca2748be8b18dbca02d242ed153945043
 build:
+  backend-flags: |
+    build-dir=build
   cflags: -Werror=implicit-function-declaration
     -Werror=mismatched-parameter-types -Werror=mismatched-return-types -Oz
   ldflags: --Wl,--fatal-warnings -Oz
