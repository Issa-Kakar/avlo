{
  "name": "@avlo/py-build",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AVLO Python runtime toolchain: forked-Pyodide build + artifact pack/verify/stage/publish via the uv-run `avlo-build` CLI (src/avlo_py_build). Turbo owns the pipeline DAG (root `pnpm py:board`); the docker lanes (fork build, recipes loop) stay manual node/bash drivers until their replatform phases and never run in Turbo/CI.",
  "scripts": {
    "build:toolchain": "node scripts/run-build.mjs",
    "clone": "node scripts/run-build.mjs --clone-only",
    "recipes:build": "node scripts/run-recipes.mjs",
    "groups:link": "node scripts/run-recipes.mjs --link-only",
    "py:wheels": "uv run avlo-build fetch-wheels",
    "py:linkrsp": "uv run avlo-build link-rsp",
    "py:stdlib": "uv run avlo-build pack-stdlib",
    "py:bundles": "uv run avlo-build pack-bundles --all",
    "py:builtins": "node scripts/node/dump-builtins.mjs",
    "py:trace-check": "uv run avlo-build trace check",
    "py:census": "uv run avlo-build census --check && uv run avlo-build verify-groups && uv run avlo-build verify-pytree",
    "py:compress": "uv run avlo-build compress",
    "py:budgets": "uv run avlo-build budgets",
    "py:stage": "uv run avlo-build stage",
    "py:stage-check": "uv run avlo-build stage --check",
    "py:corpus": "node scripts/run-corpus.mjs",
    "py:harness": "node scripts/run-harness.mjs",
    "py:seed": "uv run avlo-build publish",
    "py:repro": "uv run avlo-build repro",
    "test:py": "uv run pytest",
    "dsos": "uv run avlo-build census",
    "trace:record": "uv run avlo-build trace record",
    "publish:r2": "uv run avlo-build publish --remote"
  }
}
