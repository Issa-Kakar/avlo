{
  "name": "@avlo/py-build",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AVLO Python runtime toolchain: forked-Pyodide build, stdlib/package stripping, artifact packing + publishing. Deliberately has NO `build` script — the toolchain needs docker and never runs in Turbo/CI.",
  "scripts": {
    "build:toolchain": "node scripts/run-build.mjs",
    "clone": "node scripts/run-build.mjs --clone-only",
    "pack:stdlib": "python3.13 scripts/pack-stdlib.py",
    "baseline": "node scripts/make-baseline.mjs",
    "corpus": "node scripts/run-corpus.mjs",
    "wheels": "node scripts/fetch-wheels.mjs",
    "bundles": "python3.13 scripts/pack-package.py --all --repro",
    "trace": "node scripts/trace-imports.mjs",
    "trace:check": "node scripts/trace-imports.mjs --check",
    "compress": "node scripts/compress.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "stage": "node scripts/stage.mjs",
    "stage:check": "node scripts/stage.mjs --check",
    "seed": "node scripts/publish.mjs --local",
    "publish:r2": "node scripts/publish.mjs --remote"
  }
}
