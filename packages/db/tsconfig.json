{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "paths": {
      "@avlo/shared": ["../shared/src/index.ts"],
      "@avlo/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
