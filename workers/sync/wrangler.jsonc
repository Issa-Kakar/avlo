{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avlo-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01", // pinned per-worker; bump uniformly when needed
  "compatibility_flags": ["nodejs_compat"],

  // The Yjs sync host: WSS on /sync/* + the per-room AvloDO Y.Doc. Pure worker — no Assets
  // binding (every request hits it; non-/sync paths 404). Split out of `avlo` so SPA deploys
  // never touch the DO worker. Binding stays `rooms` (the URL party segment); class is AvloDO.
  "durable_objects": {
    "bindings": [{ "name": "rooms", "class_name": "AvloDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AvloDO"] }],
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "avlo-docs" }],

  // edge auth (AuthRpc.verifySession in onBeforeConnect) + room-event producers.
  // The DO is the sole emitter of projection events about itself (§6).
  "services": [{ "binding": "AUTH", "service": "avlo-auth", "entrypoint": "AuthRpc" }],
  "queues": {
    "producers": [{ "binding": "ROOM_VISITS", "queue": "avlo-room-visits" }, { "binding": "ROOM_META", "queue": "avlo-room-meta" }]
  },
  // drizzle-kit's generated migrations.js imports the .sql as text modules — ship them.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // routes uncommented post-DNS-transfer + remaining pre-prod essentials
  // "routes": [{ "pattern": "sync.avlo.io", "custom_domain": true }],

  "dev": { "port": 8787 },
  "observability": { "enabled": true },
  "minify": true
}
