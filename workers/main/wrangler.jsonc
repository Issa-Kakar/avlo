{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avlo", // bare name preserved — canonical app identity; the asymmetry is load-bearing
  "compatibility_date": "2026-05-01", // pinned per-worker; bump uniformly when needed

  // Pure site worker: Static Assets only, NO worker script. The SPA + the _headers CSP are
  // served by Cloudflare's Static Assets layer directly (no `main`, no ASSETS binding — that
  // binding only exists to read assets FROM worker code, and there is none). Yjs sync + the
  // AvloDO live in `avlo-sync` (sync.avlo.io), so SPA deploys never touch the DO worker.
  "assets": {
    "directory": "../../web/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },

  // routes uncommented post-DNS-transfer + remaining pre-prod essentials
  // "routes": [
  //   { "pattern": "avlo.io",     "custom_domain": true },
  //   { "pattern": "www.avlo.io", "custom_domain": true }
  // ],

  "observability": { "enabled": true }
}
